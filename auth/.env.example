# ── Core ──────────────────────────────────────────────────────────────
# Postgres database of this service (one Postgres server, one database per app).
DATABASE_URL=postgres://postgres@localhost:5432/tretu_auth
# Issuer = public base URL, no trailing slash. Production: https://auth.tretu.de
TRETU_AUTH_ISSUER=http://localhost:3021
# 32+ random characters (`npm run secrets` prints one). Also encrypts the ID token signing keys: never rotate casually.
BETTER_AUTH_SECRET=
# WebAuthn RP ID. Default: tretu.de for *.tretu.de issuers (passkeys work on every subdomain), else the issuer host.
AUTH_PASSKEY_RP_ID=

# ── OIDC clients (contract §2) ────────────────────────────────────────
# Synced into the database at boot and by `npm run clients:sync`. See README for the full example.
# `npm run secrets` prints a fresh secret per confidential client (nothing is stored).
TRETU_OAUTH_CLIENTS_JSON=
# CORS for token/userinfo/JWKS (comma-separated https origins). Default: the https origins of public clients.
TRETU_CORS_ORIGINS=
# Set to "false" to skip the client sync at `npm start`.
CLIENTS_SYNC_ON_START=true

# ── Sign-in providers (each only active when both values are set) ────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ── Steam (OpenID 2.0; Steam has no OAuth). Off unless STEAM_LOGIN=true. ──
# No client registration at Steam: the return URL is https://auth.tretu.de/api/auth/steam/callback and the realm
# shown at Steam is https://auth.tretu.de/ (both derived from TRETU_AUTH_ISSUER).
STEAM_LOGIN=false
# Optional (https://steamcommunity.com/dev/apikey, domain auth.tretu.de): persona name + avatar for new accounts.
STEAM_WEB_API_KEY=

# ── "Verknüpfen" targets in Mein Konto (Minecraft and TeamSpeak are linked by those services) ──
TRETU_MC_LINK_URL=https://mc.tretu.de/verknuepfen
TRETU_TS_LINK_URL=https://tretu.de/einstellungen#teamspeak

# ── Email (Amazon SES v2). Without SES_REGION emails are printed to the console. ──
# Credentials: the usual AWS variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or an instance profile.
SES_REGION=
SES_CONFIGURATION_SET=
EMAIL_FROM=Tretu-Konto <konto@tretu.de>

# ── Cloudflare Turnstile on registration (optional, both keys) ───────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Ecosystem (contract §1, §3, §4) ───────────────────────────────────
# Every app's signing secret, used to verify admin API requests: {"saga":{"secret":"…"},"play":{"secret":"…"},…}
TRETU_APPS_JSON=
# Platform event delivery (user.created/updated/deleted). Off unless both are set.
TRETU_PLATFORM_URL=
TRETU_APP_SECRET=
TRETU_LEGAL_URL=https://tretu.de

# ── Analytics (optional, both values; set before `npm run build`) ────
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Legacy import (read-only connections to the old apps' databases) ──
LEGACY_SAGA_DATABASE_URL=
LEGACY_PLAY_DATABASE_URL=
LEGACY_TRETU_DATABASE_URL=
LEGACY_NAKAMA_DATABASE_URL=
# Days after the import during which old accounts can be claimed in "Alte Konten verbinden".
LEGACY_CLAIM_DAYS=90

# ── Tests only (never in production) ──────────────────────────────────
# AUTH_RATE_LIMIT=off
# AUTH_HIBP=off
# MAIL_OUTBOX_DIR=.outbox
# A stub Steam OpenID endpoint; refused (startup fails) unless TRETU_AUTH_ISSUER is plain http on localhost.
# STEAM_OPENID_ENDPOINT=http://127.0.0.1:3124/openid/login
# Used only by tests/support/intercept-fetch.mjs, which only the integration test harness preloads.
# TRETU_TEST_PROVIDER_MOCK=http://127.0.0.1:3123
