{
  "name": "tretu-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Tretu-Konto: the central identity provider (OIDC) of the Tretu gaming community at auth.tretu.de.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 3021",
    "build": "next build",
    "start": "next start -p 3021",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "clients:sync": "tsx --env-file-if-exists=.env scripts/clients-sync.ts",
    "worker:events": "tsx --env-file-if-exists=.env scripts/worker-events.ts",
    "import:legacy": "tsx --env-file-if-exists=.env scripts/import-legacy.ts",
    "admin": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "secrets": "tsx scripts/secrets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@better-auth/core": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@better-auth/passkey": "1.7.15",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "@fontsource-variable/jost": "5.3.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.15",
    "better-call": "1.4.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.14",
    "lucide-react": "1.66.0",
    "nanostores": "1.5.5",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "openid-client": "6.8.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
