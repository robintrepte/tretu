# Copy this file to `.env.local` and fill in the values.
# `.env.local` is loaded automatically by Next.js and must never be committed.
#
# Keep quotes around string values. Keep booleans/numbers unquoted.

# =============================================================================
# PUBLIC RUNTIME VARIABLES (safe for browser, exposed in client bundles)
# =============================================================================

# Public base URL used for metadata/canonical links.
NEXT_PUBLIC_SITE_URL="https://tretu.de"

# Discord server id used by the public community widgets/pages.
NEXT_PUBLIC_DISCORD_SERVER_ID="262342293250506752"

# Twitch channel used by livestream embeds.
NEXT_PUBLIC_TWITCH_CHANNEL="tretude"

# TSViewer server id used on Teamspeak page.
NEXT_PUBLIC_TSVIEWER_ID=1118784


# =============================================================================
# SERVER RUNTIME VARIABLES (server-only secrets/config)
# =============================================================================

# YouTube RSS channel id used by /api/youtube-videos.
YOUTUBE_CHANNEL_ID="UCrn4oucvfow7jUNGSeE7ySg"

# SQLite database file path (also used by drizzle.config.ts).
# Examples:
# - "local.sqlite"
# - "./data/tretu.sqlite"
# - "C:\\path\\to\\tretu.sqlite"
SQLITE_DATABASE_PATH="local.sqlite"

# NextAuth secret for signing session/JWT data.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-long-random-secret"

# Canonical auth base URL (required for stable OAuth callback handling).
NEXTAUTH_URL="http://localhost:3020"

# Needed when app runs behind reverse proxies.
AUTH_TRUST_HOST=true

# Discord OAuth app credentials (Developer Portal -> OAuth2).
AUTH_DISCORD_CLIENT_ID=""
AUTH_DISCORD_CLIENT_SECRET=""

# CurseForge Core API key (required for CurseForge modpack search/files).
CURSEFORGE_API_KEY=""

# Hetzner Cloud API token (project-scoped).
HETZNER_API_TOKEN=""

# Default Hetzner region for provisioning.
HETZNER_DEFAULT_REGION="fsn1"

# Volume size (GB) when creating a new game instance (Hetzner minimum is 10).
HETZNER_DEFAULT_VOLUME_GB=10

# Image slug for new hosts (e.g. ubuntu-24.04).
HETZNER_DEFAULT_SERVER_IMAGE="ubuntu-24.04"

# Comma-separated SSH key IDs from Hetzner Cloud (Security → SSH keys); required to create servers.
HETZNER_SSH_KEY_IDS=""

# Absolute path to private SSH key used for host orchestration.
HETZNER_SSH_PRIVATE_KEY_PATH=""

# SSH user for remote orchestration.
HETZNER_SSH_USER="root"

# =============================================================================
# TEAMSPEAK RANKING (ServerQuery worker + /ranking page)
# =============================================================================

# TeamSpeak ServerQuery (required for worker:ts-rank).
# From your PC: often blocked — use SSH tunnel or run worker on the TS machine.
# On s.tretu.de / same host as TS: TS_QUERY_HOST=127.0.0.1
# Remote PC with tunnel: ssh -L 10011:127.0.0.1:10011 user@host → TS_QUERY_HOST=127.0.0.1
TS_QUERY_HOST=""
TS_QUERY_PORT=10011
TS_QUERY_USER=""
TS_QUERY_PASSWORD=""
TS_VIRTUALSERVER_PORT=9987
TS_RANK_POLL_INTERVAL_SEC=30

# Active time only: rank while client_idle_time ≤ grace (seconds). Default 300 = 5 min.
TS_RANK_IDLE_GRACE_SEC=300

# Channels whose name contains any of these (comma-separated, case-insensitive) earn no rank time.
TS_RANK_AFK_CHANNEL_MATCH=afk

# Delay between clients for npm run ts:resync-rank-groups (avoids TS query flood ban).
TS_RESYNC_DELAY_MS=200

# Delay between group add/remove commands during sync (ms).
TS_GROUP_CMD_DELAY_MS=50

# Resume resync after disconnect: user index (0-based), e.g. TS_RESYNC_START_AT=120
# TS_RESYNC_START_AT=0

# One-time import from legacy ts-ranksystem mysqldump (gitignored).
RANKSYSTEM_SQL_DUMP="./data/ranksystem-full.sql"
