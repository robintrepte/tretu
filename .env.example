# Copy this file to `.env.local` and fill in the values.
# `.env.local` is loaded automatically by Next.js and must never be committed.
#
# Keep quotes around string values. Keep booleans/numbers unquoted.

# =============================================================================
# PUBLIC RUNTIME VARIABLES (safe for browser, exposed in client bundles)
# =============================================================================

# Public base URL used for metadata/canonical links.
NEXT_PUBLIC_SITE_URL="https://tretu.de"

# Discord server id used by the public community widgets/pages.
NEXT_PUBLIC_DISCORD_SERVER_ID="262342293250506752"

# Twitch channel used by livestream embeds.
NEXT_PUBLIC_TWITCH_CHANNEL="tretude"

# TSViewer server id used on Teamspeak page.
NEXT_PUBLIC_TSVIEWER_ID=1118784

# Self-hosted Umami (cookie-free). The script tag is only rendered when both are set (build time).
# NEXT_PUBLIC_UMAMI_SRC="https://stats.tretu.de/script.js"
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=""


# =============================================================================
# SERVER RUNTIME VARIABLES (server-only secrets/config)
# =============================================================================

# YouTube RSS channel id used by /api/youtube-videos.
YOUTUBE_CHANNEL_ID="UCrn4oucvfow7jUNGSeE7ySg"

# Postgres connection string (database tretu_web, own role per app; see deploy/README.md).
DATABASE_URL="postgres://tretu_web:CHANGE_ME@localhost:5432/tretu_web"
# Optional: connections per process (default 10).
# DATABASE_POOL_MAX=10

# Only for the one-time upgrade from the SQLite version (npm run db:migrate-sqlite).
# SQLITE_DATABASE_PATH="./local.sqlite"

# Secret for signing session cookies (Better Auth). AUTH_SECRET keeps working; BETTER_AUTH_SECRET wins.
# It also encrypts dashboard secrets unless DASHBOARD_SECRET_KEY is set – do not change it later.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-long-random-secret"
# BETTER_AUTH_SECRET=""

# Public base URL of this app; OAuth callbacks are built from it (NEXTAUTH_URL is still read as a fallback).
BETTER_AUTH_URL="http://localhost:3020"

# Discord OAuth app credentials (Developer Portal -> OAuth2).
# Redirect URL: <BETTER_AUTH_URL>/api/auth/callback/discord (unchanged from NextAuth).
AUTH_DISCORD_CLIENT_ID=""
AUTH_DISCORD_CLIENT_SECRET=""

# Tretu-Konto (auth.tretu.de). All three set → "Mit Tretu-Konto anmelden" becomes the primary login.
# Redirect URL registered at auth.tretu.de: <BETTER_AUTH_URL>/api/auth/oauth2/callback/tretu
# Post-logout redirect URL: <BETTER_AUTH_URL>/
# TRETU_AUTH_ISSUER="https://auth.tretu.de"
# TRETU_AUTH_CLIENT_ID="tretu-web"
# TRETU_AUTH_CLIENT_SECRET=""
# Keep the direct Discord login as a fallback (default true).
# TRETU_DISCORD_FALLBACK=true
# Grant the dashboard admin role to users whose Tretu-Konto has the "admin" role (default false).
# TRETU_ADMIN_FROM_ROLES=false

# Discord user ids that get the dashboard admin role on login (comma-separated).
DASHBOARD_ADMIN_DISCORD_IDS=""

# Key for encrypting tokens stored by the dashboard setup (defaults to AUTH_SECRET).
# DASHBOARD_SECRET_KEY=""

# Game-server dashboard: Hetzner, Cloudflare and CurseForge are configured in the UI
# (/dashboard/setup). The variables below are optional fallbacks.
# HETZNER_API_TOKEN=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_DOMAIN="tretu.de"
# CURSEFORGE_API_KEY=""

# Base image for game VMs.
HETZNER_DEFAULT_SERVER_IMAGE="ubuntu-24.04"

# Run the orchestrator inside the Next.js server (default for `npm run dev`). ecosystem.config.cjs sets it to false
# for tretu-web and runs `tretu-orchestrator` as its own PM2 process.
# ORCHESTRATOR_EMBEDDED=true

# =============================================================================
# TEAMSPEAK RANKING (ServerQuery worker + /ranking page)
# =============================================================================

# TeamSpeak ServerQuery (required for worker:ts-rank).
# From your PC: often blocked — use SSH tunnel or run worker on the TS machine.
# On s.tretu.de / same host as TS: TS_QUERY_HOST=127.0.0.1
# Remote PC with tunnel: ssh -L 10011:127.0.0.1:10011 user@host → TS_QUERY_HOST=127.0.0.1
TS_QUERY_HOST=""
TS_QUERY_PORT=10011
TS_QUERY_USER=""
TS_QUERY_PASSWORD=""
TS_VIRTUALSERVER_PORT=9987
TS_RANK_POLL_INTERVAL_SEC=30

# Active time only: rank while client_idle_time ≤ grace (seconds). Default 300 = 5 min.
TS_RANK_IDLE_GRACE_SEC=300

# Channels whose name contains any of these (comma-separated, case-insensitive) earn no rank time.
TS_RANK_AFK_CHANNEL_MATCH=afk

# Delay between clients for npm run ts:resync-rank-groups (avoids TS query flood ban).
TS_RESYNC_DELAY_MS=200

# Delay between group add/remove commands during sync (ms).
TS_GROUP_CMD_DELAY_MS=50

# Resume resync after disconnect: user index (0-based), e.g. TS_RESYNC_START_AT=120
# TS_RESYNC_START_AT=0

# One-time import from legacy ts-ranksystem mysqldump (gitignored).
RANKSYSTEM_SQL_DUMP="./data/ranksystem-full.sql"
