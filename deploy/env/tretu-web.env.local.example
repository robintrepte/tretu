# tretu-web: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/tretu/.env.local (chmod 600). See DEPLOY.md, docs/ecosystem/PLATFORM.md.
# Empty values switch that integration off; fill in the ones marked 'external' by hand.

# Public (inlined at build time: rebuild after changes)
NEXT_PUBLIC_SITE_URL=https://tretu.de
NEXT_PUBLIC_DISCORD_SERVER_ID=262342293250506752
NEXT_PUBLIC_TWITCH_CHANNEL=tretude
NEXT_PUBLIC_TSVIEWER_ID=1118784

# Server
YOUTUBE_CHANNEL_ID=UCrn4oucvfow7jUNGSeE7ySg
DATABASE_URL='postgres://tretu_web:<generated>@localhost:5432/tretu_web'
# signs sessions and encrypts dashboard secrets: import the existing one on an upgrade
AUTH_SECRET='<generated>'
BETTER_AUTH_URL=https://tretu.de
# external: Discord OAuth app, redirect <BETTER_AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_CLIENT_ID=
# external
AUTH_DISCORD_CLIENT_SECRET=
# external: comma-separated Discord user ids
DASHBOARD_ADMIN_DISCORD_IDS=
HETZNER_DEFAULT_SERVER_IMAGE=ubuntu-24.04

# Tretu-Konto login (contract §2)
TRETU_AUTH_ISSUER=https://auth.tretu.de
TRETU_AUTH_CLIENT_ID=tretu-web
TRETU_AUTH_CLIENT_SECRET='<generated>'
TRETU_DISCORD_FALLBACK=true
TRETU_ADMIN_FROM_ROLES=false

# Platform (contract §3–§5)
TRETU_APPS_JSON='{"tretu-web":{"secret":"<generated>"},"auth":{"secret":"<generated>"},"saga":{"secret":"<generated>","webhook":"https://saga.tretu.de/api/tretu/webhook"},"play":{"secret":"<generated>","webhook":"https://play.tretu.de/api/tretu/webhook"},"hollowmere":{"secret":"<generated>"},"mc-dashboard":{"secret":"<generated>","webhook":"https://mc.tretu.de/api/tretu/webhook"}}'
TRETU_APP_ID=tretu-web
TRETU_APP_SECRET='<generated>'
TRETU_PLATFORM_URL=https://tretu.de
WEB_PUSH_PUBLIC_KEY='<generated>'
WEB_PUSH_PRIVATE_KEY='<generated>'
WEB_PUSH_SUBJECT=mailto:business@tretu.de

# Status page tretu.de/status (checks run in tretu-platform-worker, see DEPLOY.md)
TRETU_STATUS_TARGETS_JSON='[{"id":"tretu-web","url":"https://tretu.de/api/health"},{"id":"auth","url":"https://auth.tretu.de/api/health"},{"id":"saga","url":"https://saga.tretu.de/api/health"},{"id":"play","url":"https://play.tretu.de/api/health"},{"id":"hollowmere","url":"https://hollowmere.tretu.de/api/health"},{"id":"mc-dashboard","url":"https://mc.tretu.de/api/health"}]'
TRETU_STATUS_MINECRAFT=mc.tretu.de:25565
# external: optional host:port for a TCP check when TS_QUERY_* is not set (ServerQuery is used otherwise)
TRETU_STATUS_TEAMSPEAK=
# certificates to watch besides the hosts above
TRETU_STATUS_CERT_HOSTS=map.tretu.de,mcp.hollowmere.tretu.de
# external: optional: Discord webhook for outage and recovery messages
TRETU_STATUS_DISCORD_WEBHOOK_URL=
# external: optional: maintenance note shown on /status
TRETU_STATUS_NOTICE=

# Badge → Discord role / TeamSpeak group sync (off while the mappings are empty)
# external: bot with Manage Roles, role above the badge roles
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=262342293250506752
# external: {"wins-10":"<role id>",…}
TRETU_BADGE_DISCORD_ROLES_JSON=
# external: {"wins-10":31,…}
TRETU_BADGE_TS_GROUPS_JSON=

# TeamSpeak ServerQuery (ranking worker, TeamSpeak link, badge groups)
TS_QUERY_HOST=127.0.0.1
TS_QUERY_PORT=10011
# external
TS_QUERY_USER=
# external
TS_QUERY_PASSWORD=
TS_VIRTUALSERVER_PORT=9987
