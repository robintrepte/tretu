# hollowmere server/nakama/local.yml: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/hollowmere/server/nakama/local.yml (chmod 600). See hollowmere HOSTING.md.
database:
  address:
    - "nakama:<generated>@127.0.0.1:5432/nakama"
session:
  encryption_key: "<generated>"
  refresh_encryption_key: "<generated>"
runtime:
  # Same value as NAKAMA_HTTP_KEY in server/.env.
  http_key: "<generated>"
  env:
    - "TRETU_AUTH_ISSUER=https://auth.tretu.de"
    - "TRETU_PLATFORM_URL=https://tretu.de"
    - "TRETU_APP_ID=hollowmere"
    - "TRETU_APP_SECRET=<generated>"
    - "HOLLOWMERE_PUBLIC_URL=https://hollowmere.tretu.de"
    - "TRETU_PLATFORM_BACKOFF_SEC=15"
console:
  # Nakama console (127.0.0.1:7351 only, reach it through an SSH tunnel).
  username: "admin"
  password: "<generated>"
social:
  apple:
    bundle_id: "com.hollowmere.unset"
