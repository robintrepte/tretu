# auth: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/tretu/auth/.env (chmod 600). See auth/DEPLOY.md.
# Empty values switch that integration off; fill in the ones marked 'external' by hand.

# Core
DATABASE_URL='postgres://tretu_auth:<generated>@localhost:5432/tretu_auth'
TRETU_AUTH_ISSUER=https://auth.tretu.de
# also encrypts the ID token signing keys: never rotate casually
BETTER_AUTH_SECRET='<generated>'
AUTH_PASSKEY_RP_ID=tretu.de

# OIDC clients (contract §2), synced at boot
TRETU_OAUTH_CLIENTS_JSON='{"tretu-web":{"type":"confidential","secret":"<generated>","name":"tretu.de","redirectUris":["https://tretu.de/api/auth/oauth2/callback/tretu"],"postLogoutRedirectUris":["https://tretu.de/"]},"saga":{"type":"confidential","secret":"<generated>","name":"Saga","redirectUris":["https://saga.tretu.de/api/auth/oauth2/callback/tretu"],"postLogoutRedirectUris":["https://saga.tretu.de/"]},"play":{"type":"confidential","secret":"<generated>","name":"Play","redirectUris":["https://play.tretu.de/api/auth/oauth2/callback/tretu"],"postLogoutRedirectUris":["https://play.tretu.de/"]},"mc-dashboard":{"type":"confidential","secret":"<generated>","name":"Minecraft","redirectUris":["https://mc.tretu.de/auth/callback"],"postLogoutRedirectUris":["https://mc.tretu.de/"]},"hollowmere":{"type":"public","name":"Hollowmere","redirectUris":["https://hollowmere.tretu.de/auth/callback","http://127.0.0.1/callback"],"postLogoutRedirectUris":["https://hollowmere.tretu.de/"]}}'
# external: optional, comma-separated; default: the https origins of the public clients
TRETU_CORS_ORIGINS=

# Sign-in providers (each only active when both values are set)
# external: redirect https://auth.tretu.de/api/auth/callback/discord
DISCORD_CLIENT_ID=
# external
DISCORD_CLIENT_SECRET=
# external: redirect https://auth.tretu.de/api/auth/callback/google
GOOGLE_CLIENT_ID=
# external
GOOGLE_CLIENT_SECRET=
# external
APPLE_CLIENT_ID=
# external
APPLE_CLIENT_SECRET=
# external
APPLE_APP_BUNDLE_IDENTIFIER=
STEAM_LOGIN=true
# external: optional: persona name and avatar
STEAM_WEB_API_KEY=
TRETU_MC_LINK_URL=https://mc.tretu.de/verknuepfen
TRETU_TS_LINK_URL='https://tretu.de/einstellungen#teamspeak'

# Email (Amazon SES v2)
# external: e.g. eu-central-1
SES_REGION=
# external
SES_CONFIGURATION_SET=
EMAIL_FROM='Tretu-Konto <konto@tretu.de>'
# external: IAM user with ses:SendEmail (or an instance role)
AWS_ACCESS_KEY_ID=
# external
AWS_SECRET_ACCESS_KEY=

# Cloudflare Turnstile on registration (optional)
# external
TURNSTILE_SITE_KEY=
# external
TURNSTILE_SECRET_KEY=

# Ecosystem (contract §1, §3, §4)
TRETU_APPS_JSON='{"tretu-web":{"secret":"<generated>"},"auth":{"secret":"<generated>"},"saga":{"secret":"<generated>","webhook":"https://saga.tretu.de/api/tretu/webhook"},"play":{"secret":"<generated>","webhook":"https://play.tretu.de/api/tretu/webhook"},"hollowmere":{"secret":"<generated>"},"mc-dashboard":{"secret":"<generated>","webhook":"https://mc.tretu.de/api/tretu/webhook"}}'
TRETU_PLATFORM_URL=https://tretu.de
TRETU_APP_SECRET='<generated>'
TRETU_LEGAL_URL=https://tretu.de
NEXT_PUBLIC_UMAMI_SRC=https://stats.tretu.de/script.js
# external
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Legacy import (read-only role, see deploy/scripts/create-databases.sh)
LEGACY_SAGA_DATABASE_URL='postgres://tretu_legacy_reader:<generated>@localhost:5432/saga'
LEGACY_PLAY_DATABASE_URL='postgres://tretu_legacy_reader:<generated>@localhost:5432/play'
LEGACY_TRETU_DATABASE_URL='postgres://tretu_legacy_reader:<generated>@localhost:5432/tretu_web'
LEGACY_NAKAMA_DATABASE_URL='postgres://tretu_legacy_reader:<generated>@localhost:5432/nakama'
LEGACY_CLAIM_DAYS=90
