# play: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/play/.env (chmod 600). See play DEPLOY.md.
# Empty values switch that integration off; fill in the ones marked 'external' by hand.
APP_URL=https://play.tretu.de
DATABASE_URL='postgres://play:<generated>@localhost:5432/play'
# import the existing one: a new value signs everyone out
BETTER_AUTH_SECRET='<generated>'
PORT=3030
TRUST_PROXY=true

# Email (Amazon SES)
# external
SES_REGION=
EMAIL_FROM='Tretu Play <play@tretu.de>'
# external
SES_CONFIGURATION_SET=
# external
AWS_ACCESS_KEY_ID=
# external
AWS_SECRET_ACCESS_KEY=

# Web Push (import the existing keys: new keys invalidate every subscription)
VAPID_PUBLIC_KEY='<generated>'
VAPID_PRIVATE_KEY='<generated>'
VAPID_SUBJECT=mailto:play@tretu.de
# external
TMDB_API_KEY=

# Tretu ecosystem (the Tretu-Konto is the only sign-in: required)
TRETU_AUTH_ISSUER=https://auth.tretu.de
TRETU_AUTH_CLIENT_ID=play
TRETU_AUTH_CLIENT_SECRET='<generated>'
TRETU_PLATFORM_URL=https://tretu.de
TRETU_APP_ID=play
TRETU_APP_SECRET='<generated>'
TRETU_LEGAL_URL=https://tretu.de
