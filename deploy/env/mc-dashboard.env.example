# mc-dashboard: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/tretu-minecraft/dashboard/.env (chmod 600). See tretu-minecraft README.md (dashboard).
# Empty values switch that integration off; fill in the ones marked 'external' by hand.
DATABASE_URL='postgres://mc_dashboard:<generated>@127.0.0.1:5432/mc_dashboard'
PUBLIC_URL=https://mc.tretu.de

# Tretu-Konto (confidential client mc-dashboard): the only sign-in, required
TRETU_AUTH_ISSUER=https://auth.tretu.de
TRETU_AUTH_CLIENT_ID=mc-dashboard
TRETU_AUTH_CLIENT_SECRET='<generated>'

# Signed server-to-server requests
TRETU_APP_ID=mc-dashboard
TRETU_APP_SECRET='<generated>'
TRETU_PLATFORM_URL=https://tretu.de
TRETU_LEGAL_URL=https://tretu.de
TRETU_PRESENCE=true
TRETU_PLAYTIME_EVENTS=true
