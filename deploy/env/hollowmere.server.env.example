# hollowmere: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/hollowmere/server/.env (chmod 600). See hollowmere HOSTING.md.
# Empty values switch that integration off; fill in the ones marked 'external' by hand.
NAKAMA_BIN=/opt/nakama/nakama
# same as runtime.http_key in server/nakama/local.yml
NAKAMA_HTTP_KEY='<generated>'
MCP_PORT=8787
MCP_PUBLIC_URL=https://mcp.hollowmere.tretu.de
