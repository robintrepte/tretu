# city: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/city/.env (chmod 600). See city.tretu.de DEPLOY.md.
# Empty values switch that integration off; fill in the ones marked 'external' by hand.
CITY_PUBLIC_URL=https://city.tretu.de
DATABASE_URL='postgres://city:<generated>@127.0.0.1:5432/city'

# Tretu-Konto (confidential client city): the only sign-in, required
TRETU_AUTH_ISSUER=https://auth.tretu.de
TRETU_AUTH_CLIENT_ID=city
TRETU_AUTH_CLIENT_SECRET='<generated>'

# Tretu platform (contract §3–§4): signed requests, stats, presence, invites; webhooks at /api/tretu/webhook
TRETU_PLATFORM_URL=https://tretu.de
TRETU_APP_ID=city
TRETU_APP_SECRET='<generated>'
TRETU_LEGAL_URL=https://tretu.de

# Optional limits (defaults shown)
# CITY_CHECKPOINT_MINUTES=10
# CITY_UNLOAD_MINUTES=10
# CITY_MAX_RUNNING=10
# CITY_MAX_UNATTENDED_SPEED=1
