# saga: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/saga/.env (chmod 600). See adventure.ai DEPLOY.md.
# Empty values switch that integration off; fill in the ones marked 'external' by hand.
DATABASE_URL='postgresql://saga:<generated>@localhost:5432/saga?schema=public'
# import the existing one: a new value signs everyone out
AUTH_SECRET='<generated>'
AUTH_URL=https://saga.tretu.de

# AI
AI_PROVIDER=openai
# external
OPENAI_API_KEY=
# external
REPLICATE_API_TOKEN=
# external
ELEVENLABS_API_KEY=

# Discord bot (optional: campaigns played in a Discord channel)
# external
DISCORD_BOT_TOKEN=

# Email (Amazon SES)
# external
SES_REGION=
# external
AWS_ACCESS_KEY_ID=
# external
AWS_SECRET_ACCESS_KEY=
MAIL_FROM='Saga <noreply@tretu.de>'
# external
SES_CONFIGURATION_SET=

# Tretu ecosystem (the Tretu-Konto is the only sign-in: required)
TRETU_AUTH_ISSUER=https://auth.tretu.de
TRETU_AUTH_CLIENT_ID=saga
TRETU_AUTH_CLIENT_SECRET='<generated>'
TRETU_PLATFORM_URL=https://tretu.de
TRETU_APP_ID=saga
TRETU_APP_SECRET='<generated>'
TRETU_LEGAL_URL=https://tretu.de

# Real-money payments: off (Tretu is free). Only PAYMENTS_ENABLED=true turns them on (Saga docs/DEPLOYMENT.md §9).
PAYMENTS_ENABLED=false
# external
STRIPE_SECRET_KEY=
# external
STRIPE_WEBHOOK_SECRET=

# Storage and logs
# generated images and speech; must equal $saga_storage in Saga's deploy/nginx/saga.tretu.de.conf (an existing value is kept on --import)
STORAGE_DIR=/var/www/saga.tretu.de/public/images
LOG_LEVEL=info
