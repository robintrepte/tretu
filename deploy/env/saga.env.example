# saga: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/saga/.env (chmod 600). See adventure.ai DEPLOY.md.
# Empty values switch that integration off; fill in the ones marked 'external' by hand.
DATABASE_URL='postgresql://saga:<generated>@localhost:5432/saga?schema=public'
# import the existing one: a new value signs everyone out
AUTH_SECRET='<generated>'
AUTH_URL=https://saga.tretu.de

# AI
AI_PROVIDER=openai
# external
OPENAI_API_KEY=
# external
REPLICATE_API_TOKEN=
# external
ELEVENLABS_API_KEY=

# Optional sign-in providers and Discord bot
# external
DISCORD_CLIENT_ID=
# external
DISCORD_CLIENT_SECRET=
# external
DISCORD_BOT_TOKEN=
# external
GOOGLE_CLIENT_ID=
# external
GOOGLE_CLIENT_SECRET=

# Email (Amazon SES)
# external
SES_REGION=
# external
AWS_ACCESS_KEY_ID=
# external
AWS_SECRET_ACCESS_KEY=
MAIL_FROM='Saga <noreply@tretu.de>'
# external
SES_CONFIGURATION_SET=

# Tretu ecosystem
TRETU_AUTH_ISSUER=https://auth.tretu.de
TRETU_AUTH_CLIENT_ID=saga
TRETU_AUTH_CLIENT_SECRET='<generated>'
TRETU_LOCAL_LOGIN=true
TRETU_SKIP_INVITE_FOR_TRETU=true
TRETU_PLATFORM_URL=https://tretu.de
TRETU_APP_ID=saga
TRETU_APP_SECRET='<generated>'
TRETU_LEGAL_URL=https://tretu.de

# Payments (prepared, off)
# external
STRIPE_SECRET_KEY=
# external
STRIPE_WEBHOOK_SECRET=

# Storage and logs
STORAGE_DIR=/var/lib/saga/storage
LOG_LEVEL=info
