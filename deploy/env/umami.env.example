# umami: generated by deploy/scripts/generate-secrets.mjs (template, no secrets)
# Install as /srv/umami/.env (chmod 600). See deploy/README.md (Umami).
# Empty values switch that integration off; fill in the ones marked 'external' by hand.
DATABASE_URL='postgresql://umami:<generated>@localhost:5432/umami'
APP_SECRET='<generated>'
DISABLE_TELEMETRY=1
PORT=3050
HOSTNAME=127.0.0.1
