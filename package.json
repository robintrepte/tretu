{
  "name": "tretu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/db-migrate.ts",
    "db:migrate-sqlite": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/migrate-sqlite-to-postgres.ts",
    "db:push": "drizzle-kit push",
    "db:migrate-ts-ranks": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/migrate-ts-ranksystem.ts",
    "db:recalculate-ts-prestige": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/recalculate-ts-prestige.ts",
    "ts:resync-rank-groups": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/resync-ts-rank-groups.ts",
    "ts:dedupe-users": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/dedupe-ts-users.ts",
    "worker:orchestrator": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/orchestrator.ts",
    "worker:ts-rank": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/ts-rank-worker.ts",
    "ts:diagnose": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/ts-rank-diagnose.ts",
    "ts:query-probe": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/ts-query-probe.ts",
    "test:platform": "tsx --test --test-concurrency=1 'tests/platform/*.spec.ts'",
    "platform:db:push": "drizzle-kit push --config drizzle.platform.config.ts",
    "platform:worker": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/platform-worker.ts",
    "platform:seed-dev": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/platform-seed-dev.ts",
    "platform:vapid-keys": "node --import tsx ./scripts/platform-vapid-keys.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "shaders": "^4.0.6",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "description": "Tretu Gaming Community — website for tretu.de",
  "homepage": "https://tretu.de",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "tretu",
    "gaming",
    "nextjs",
    "community",
    "tretu.de"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/robintrepte/tretu.git"
  }
}
