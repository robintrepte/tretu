{
  "name": "tretu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate-ts-ranks": "node --import tsx ./scripts/migrate-ts-ranksystem.ts",
    "db:recalculate-ts-prestige": "node --import tsx ./scripts/recalculate-ts-prestige.ts",
    "ts:resync-rank-groups": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/resync-ts-rank-groups.ts",
    "ts:dedupe-users": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/dedupe-ts-users.ts",
    "worker:orchestrator": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/orchestrator.ts",
    "worker:ts-rank": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/ts-rank-worker.ts",
    "ts:diagnose": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/ts-rank-diagnose.ts",
    "ts:query-probe": "node --import tsx --import ./src/lib/env/load-local-env.ts ./scripts/ts-query-probe.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.4",
    "shaders": "^2.5.84",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.1",
    "shadcn": "^4.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "description": "Tretu Gaming Community — website for tretu.de",
  "homepage": "https://tretu.de",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tretu",
    "gaming",
    "nextjs",
    "community",
    "tretu.de"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/robintrepte/tretu.git"
  }
